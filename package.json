{
  "name": "feature-flags",
  "version": "0.1.0",
  "description": "Lightweight, type-safe feature flag SDK for TypeScript \u00e2\u0080\u0094 local rules, percentage rollouts, user targeting, and real-time updates",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest --verbose",
    "test:coverage": "jest --coverage",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "pretest": "node --test dependency-audit.test.cjs"
  },
  "keywords": [
    "feature-flags",
    "feature-toggles",
    "typescript",
    "sdk",
    "rollout",
    "targeting"
  ],
  "author": "Nripanka Das",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^5.3.0"
  },
  "overrides": {
    "js-yaml": {
      "argparse": "2.0.1"
    }
  }
}
